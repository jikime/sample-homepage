# ─────────────────────────────────────────────────────────────
# digital place homepage — Supabase 연결
#  · 네 값을 모두 비워 두면 목업 데이터(src/lib/landing/mock-data.ts)로 동작합니다.
#  · 이 파일은 형식 안내용(커밋됨)입니다. 실제 값은 .env 에 넣으세요.
# ─────────────────────────────────────────────────────────────

# 1) 프로젝트 URL — 예: https://abcdefghijklmnop.supabase.co
#    대시보드 → Project Settings → Data API(또는 상단 Connect)
NEXT_PUBLIC_SUPABASE_URL=

# 2) Publishable key(sb_publishable_…) — 공개 콘텐츠 읽기용, 브라우저에 노출돼도 되는 키
#    대시보드 → Project Settings → API Keys. 레거시 anon 키를 넣어도 됩니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 3) Secret key(sb_secret_…) — 서버 전용, 가입 신청 저장에 사용(RLS 우회)
#    대시보드 → Project Settings → API Keys. 레거시 service_role 키를 넣어도 됩니다.
#    절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SECRET_KEY=

# 4) DB 연결 문자열 — 테이블 생성·목업 데이터 입력(pnpm db:push)에만 사용, 앱 실행에는 필요 없음
#    대시보드 상단 Connect → Session pooler 문자열을 복사하고 [YOUR-PASSWORD]를 DB 비밀번호로 바꿉니다.
#    예: postgresql://postgres.abcdefghijklmnop:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
#    비밀번호에 @ : / ? # % 같은 특수문자가 있으면 URL 인코딩해야 합니다.
SUPABASE_DB_URL=
